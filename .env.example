# ─────────────────────────────────────────────
#  GateKeeper Environment Variables
#  Copy this to .env and fill in your keys.
# ─────────────────────────────────────────────

# REQUIRED — Claude AI (GateKeeper's brain)
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED for DeepSeek features
DEEPSEEK_API_KEY=sk-...

# GitHub (for creating issues, checking PRs, etc.)
# Get yours at: github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# Jira (for creating/updating tickets)
# Get token at: id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-token
JIRA_DOMAIN=yourcompany.atlassian.net

# Slack (for sending messages and alerts)
# Create a bot at: api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...

# Server
PORT=3000
