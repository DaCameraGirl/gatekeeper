# ─────────────────────────────────────────────
#  GateKeeper Environment Variables
#  Copy this to .env for local runs.
#  In GitHub Actions these are passed as secrets.
# ─────────────────────────────────────────────

# AI Keys
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# GitHub (auto-injected in Actions, set manually for local runs)
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=DaCameraGirl/gatekeeper

# PR context (auto-injected in Actions)
PR_NUMBER=1
PR_HEAD_SHA=abc123
PR_BRANCH=feat/my-feature
PR_TITLE=My Feature PR
PR_AUTHOR=octocat

# Config
FLAGS_JSON_PATH=./flags.json          # Path to flags.json in the repo
GATEKEEPER_STRICT=false               # true = WITH-CAUTION also exits non-zero
GATEKEEPER_DRY_RUN=false             # true = skip posting GitHub comment
